#!/usr/bin/env ruby
# bin/bench-chronic [ROUNDS]
# Times chronic 0.10.2 (the gem itself, not acute's chronic layer) and acute on the same ten everyday phrases,
# CPU time per parse, and prints each with the ratio. The README's and docs/chronic.md's speed claims come
# from it: run it on Ruby, then with `ruby --yjit bin/bench-chronic`. Needs `gem install chronic -v 0.10.2`.
ENV["TZ"] = "America/New_York" # chronic reads the zone from TZ
gem "chronic", "0.10.2"
require "chronic"
require_relative "../lib/acute"

PHRASES = ["tomorrow", "next tuesday 3pm", "3 days ago", "27/5/1979", "friday at noon", "in 2 hours",
           "last monday", "may 5th", "tomorrow at 4:30pm", "this afternoon"].freeze
NOW = Time.new(2026, 10, 17, 14, 0, 0, "-04:00")
ZONE = "America/New_York".freeze
ROUNDS = Integer(ARGV.fetch(0, 5))

def per_call(n, &)
  n.times(&) # warm up, so YJIT has compiled what it will
  best = Array.new(ROUNDS) do
    t0 = Process.clock_gettime(Process::CLOCK_PROCESS_CPUTIME_ID)
    n.times(&)
    (Process.clock_gettime(Process::CLOCK_PROCESS_CPUTIME_ID) - t0) / n
  end
  best.min * 1e6
end

PHRASES.each do |text|
  abort "chronic can't read #{text.inspect}" unless Chronic.parse(text, now: NOW)
  abort "acute can't read #{text.inspect}" unless Acute.parse(text, now: NOW, zone: ZONE)
end

mode = defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? ? "YJIT" : "interpreter"
puts "Ruby #{RUBY_VERSION}, #{mode}, best of #{ROUNDS} rounds, µs a parse"
puts "phrase                 chronic     acute  faster"
ratios = PHRASES.map do |text|
  chronic = per_call(300) { Chronic.parse(text, now: NOW) }
  acute = per_call(3_000) { Acute.parse(text, now: NOW, zone: ZONE) }
  puts format("%-20s %9.1f %9.1f %6.0f×", text, chronic, acute, chronic / acute)
  chronic / acute
end
puts format("faster by %.0f–%.0f×, median %.0f×", ratios.min, ratios.max, ratios.sort[ratios.size / 2])
