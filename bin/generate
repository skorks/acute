#!/usr/bin/env ruby
# Writes lib/acute/tables/*.rb from data/*.yml. With --check, only reports whether they are stale.
require "yaml"

ROOT = File.expand_path("..", __dir__)

def header(source) = "# GENERATED by bin/generate from #{source}; do not edit\n# frozen_string_literal: true\n\n"

def value(v) = v.is_a?(String) ? ":#{v}" : (v.is_a?(Array) ? "#{v.inspect}.freeze" : v.inspect)

def words_rb
  data = YAML.load_file(File.join(ROOT, "data/words.yml"))
  misspellings = data.delete("misspellings")
  phrases = data.delete("phrases")
  english = data.delete("english")
  plural = data.delete("plural")
  words = data.flat_map { |kind, entries| entries.map { |word, v| [word, kind, v] } }
  by_word = words.to_h { |word, kind, v| [word, [kind, v]] }
  misspellings.each { |wrong, right| words << [wrong, *by_word.fetch(right)] }
  unknown = english - by_word.keys
  abort "english: not in the word table: #{unknown.join(", ")}" unless unknown.empty?
  unknown = plural - by_word.keys - phrases.keys
  abort "plural: not in the word table: #{unknown.join(", ")}" unless unknown.empty?
  hints = data.values.flat_map(&:keys).select { |w| w.size >= 3 }.sort

  out = +header("data/words.yml")
  out << "module Acute\n  module Tables\n    WORDS = {\n"
  words.each { |word, kind, v| out << "      #{word.inspect} => [:#{kind}, #{value(v)}].freeze,\n" }
  out << "    }.freeze\n\n    PHRASES = {\n"
  phrases.sort_by { |p, _| -p.split.size }.each do |p, (kind, v)|
    out << "      #{p.inspect} => [:#{kind}, #{value(v)}].freeze,\n"
  end
  out << "    }.freeze\n\n"
  out << "    ENGLISH = #{english.inspect}.freeze\n\n"
  out << "    PLURAL = #{plural.inspect}.freeze\n\n"
  out << "    HINT_WORDS = #{hints.inspect}.freeze\n  end\nend\n"
end

def assumptions_rb
  data = YAML.load_file(File.join(ROOT, "data/assumptions.yml"))
  out = +header("data/assumptions.yml")
  out << "module Acute\n  module Tables\n    ASSUMPTIONS = {\n"
  data.each { |code, a| out << "      #{code}: [#{a["rule"].inspect}, #{a["message"].inspect}].freeze,\n" }
  out << "    }.freeze\n  end\nend\n"
end

outputs = { "lib/acute/tables/words.rb" => words_rb, "lib/acute/tables/assumptions.rb" => assumptions_rb }

if ARGV.include?("--check")
  stale = outputs.reject { |path, body| File.exist?(File.join(ROOT, path)) && File.read(File.join(ROOT, path)) == body }.keys
  abort "stale: #{stale.join(", ")} (run bin/generate)" unless stale.empty?
  puts "tables up to date"
else
  outputs.each { |path, body| File.write(File.join(ROOT, path), body) }
  puts "wrote #{outputs.keys.join(", ")}"
end
