#!/usr/bin/env ruby
# The one command: tables, lint, unit tests, corpus ratchet, chronic compatibility, fuzz, coverage, speed on
# the interpreter and under YJIT. Prints one line per stage, and the failures of a stage that failed.
#   bin/check [--record] [--only tables|lint|unit|corpus|chronic|fuzz|coverage|speed|yjit] [--grep TEXT] [--file NAME] [--rule D20]
# --grep and --file narrow the corpus and imply --only corpus. --record updates test/corpus/passing.txt and
# test/chronic/differences.yml.
# The yjit stage runs YJIT_RUBY, or this ruby, with --yjit, and is skipped when that ruby has no YJIT.
# --rule runs the cases tagged with or noting that rule and the unit tests that mention it, and lists the
# rules no case covers.
require "open3"
require "rbconfig"

ROOT = File.expand_path("..", __dir__)
RUBY = RbConfig.ruby
YJIT_RUBY = ENV["YJIT_RUBY"] || RUBY
UNIT = 'Dir["test/unit/*_test.rb"].sort.each { |f| require_relative File.expand_path(f) }'.freeze
RULE_STAGES = %w[unit corpus].freeze

args = ARGV.dup
only = (i = args.index("--only")) && args.slice!(i, 2)[1]
corpus_args = []
%w[--grep --file].each { |flag| (i = args.index(flag)) && corpus_args.concat(args.slice!(i, 2)) }
corpus_args << args.delete("--record") if args.include?("--record")
rule = (i = args.index("--rule")) && args.slice!(i, 2)[1]
abort "unknown arguments: #{args.join(" ")}" unless args.empty?
abort "--rule takes a rule like D20" if rule && !rule.match?(/\AD\d+\z/)
only ||= "corpus" if corpus_args.any? { _1 == "--grep" || _1 == "--file" }

# The unit tests whose name, body or the comment above them mentions the rule
def tests_naming(rule)
  Dir[File.join(ROOT, "test/unit/*_test.rb")].flat_map do |path|
    File.read(path).split(/^(?=(?:  #.*\n)*  def )/).filter_map do |chunk|
      name = chunk[/^  def (test_\w+)/, 1]
      name if name && (chunk.match?(/\b#{rule}\b/) || name.match?(/_#{rule.downcase}_/))
    end
  end
end

STAGES = {
  "tables" => [[RUBY, "bin/generate", "--check"], ->(out) { out.lines.last }],
  "lint" => [[RUBY, "-S", "bundle", "exec", "rubocop", "--no-color"], ->(out) { out.lines.last }],
  "unit" => if rule && (names = tests_naming(rule)).empty?
              [[RUBY, "-e", "puts 'no unit tests mention #{rule}'"], ->(out) { out }]
            else
              [[RUBY, "-Itest", "-e", UNIT, *(["--", "-n", "/^(?:#{names.join("|")})$/"] if rule)], ->(out) { out[/^\d+ runs.*$/] }]
            end,
  "corpus" => [[RUBY, "test/corpus.rb", *corpus_args, *(["--rule", rule] if rule)], ->(out) { out }],
  "chronic" => [[RUBY, "test/chronic/run.rb", *(["--record"] if corpus_args.include?("--record"))], ->(out) { out.lines.first }],
  "fuzz" => [[RUBY, "test/fuzz.rb"], ->(out) { out }],
  "coverage" => [[RUBY, "test/coverage.rb"], ->(out) { out }],
  "speed" => [[RUBY, "test/speed.rb"], ->(out) { out }],
  "yjit" => if system(YJIT_RUBY, "--yjit", "-e", "exit RubyVM::YJIT.enabled?", err: File::NULL)
              [[YJIT_RUBY, "--yjit", "test/speed.rb"], ->(out) { out }]
            else
              [[RUBY, "-e", "puts 'skipped: #{YJIT_RUBY} has no YJIT (set YJIT_RUBY)'"], ->(out) { out }]
            end
}.freeze
abort "--only takes one of #{STAGES.keys.join(", ")}" if only && !STAGES.key?(only)
abort "--rule runs the unit and corpus stages" if rule && only && !RULE_STAGES.include?(only)

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
failed = STAGES.select { |name, _| only ? only == name : !rule || RULE_STAGES.include?(name) }.reject do |name, (cmd, summary)|
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  out, status = Open3.capture2e(*cmd, chdir: ROOT)
  secs = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0
  shown = status.success? ? summary.(out).to_s.strip : out.strip
  printf "%s %-7s %5.1fs  %s\n", status.success? ? "ok  " : "FAIL", name, secs, shown.gsub("\n", "\n#{" " * 20}")
  status.success?
end
printf "%s in %.1fs\n", failed.empty? ? "all passed" : "failed: #{failed.keys.join(", ")}",
       Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
exit failed.empty?
