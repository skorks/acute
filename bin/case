#!/usr/bin/env ruby
# bin/case "tomorrow at 4pm" [--now 2026-10-17T14:00] [--zone America/New_York] [--context past] [--to FILE]
# Appends acute's current answer as a case to research/cases/new.jsonl (or FILE) and prints it. The answer is
# unreviewed: check it against the D-rules before moving the case to its theme's file.
require "json"
require_relative "../test/corpus"

args = ARGV.dup
opt = ->(name) { (i = args.index(name)) && args.slice!(i, 2)[1] }
now = opt.("--now") || "2026-10-17T14:00"
now += ":00" if now.size == 16
zone = opt.("--zone") || "America/New_York"
context = opt.("--context")
file = opt.("--to") || File.join(Corpus::CASES, "new.jsonl")
text = args.join(" ")
abort File.read(__FILE__).lines[1].delete_prefix("# ") if text.empty?

tz = Corpus::TZS[zone]
# Local wall time, with the offset only when the wall time alone would name another instant (a fall-back hour)
wall = lambda do |epoch|
  next if epoch.nil?
  t = tz.to_local(Time.at(epoch))
  s = t.strftime("%FT%T")
  Corpus.epoch(s, tz) == epoch ? s : t.strftime("%FT%T%:z")
end
expect_of = lambda do |r|
  b = r.begin&.to_i
  e = r.end&.to_i
  if b && e && Corpus::GRAINS.include?(r.grain.to_s)
    single = { "time" => wall.(b), "grain" => r.grain.to_s }
    next single if Corpus.interval(single, tz) == [b, e]
  end
  { "span" => [wall.(b), wall.(e)] }
end

r = Acute.parse(text, now: Time.at(Corpus.epoch(now, tz)), zone: zone, context: (context || :future).to_sym)
expect = if r.nil? then { "nil" => true }
         elsif r.ambiguous? then { "alternatives" => [r, *r.alternatives].map(&expect_of) }
         else expect_of.(r)
         end

taken = File.exist?(file) ? File.foreach(file).filter_map { |l| l[/"id":"new-(\d+)"/, 1]&.to_i } : []
c = { "id" => format("new-%04d", (taken.max || 0) + 1), "text" => text, "now" => now, "tz" => zone }
c["options"] = { "context" => context } if context
c.merge!("expect" => expect, "source" => "bin/case", "note" => "acute's answer when recorded; unreviewed")
line = JSON.generate(c)
File.open(file, "a") { |f| f.puts(line) }
puts line
