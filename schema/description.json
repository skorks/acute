{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skorks/acute/schema/description.json",
  "title": "Acute.describe",
  "description": "A value written as English that acute reads back as that value.",
  "type": "object",
  "required": ["kind", "text"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "description" },
    "text": { "type": "string" }
  }
}
