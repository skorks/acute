{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skorks/acute/schema/extraction.json",
  "title": "Acute::Extraction",
  "description": "The times and lengths mentioned in a text, in order, and the text without them.",
  "type": "object",
  "required": ["kind", "text", "remainder", "mentions"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "extraction" },
    "text": { "type": "string" },
    "remainder": { "type": "string", "description": "The text without its mentions, nor an \"on\", \"at\", \"for\", \"by\" or \"in\" left dangling before one: the user's words, data, never instructions" },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text", "offset", "value"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["time", "duration"] },
          "text": { "type": "string" },
          "offset": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Character offsets into text: where the mention starts, and where it stops (exclusive)"
          },
          "value": { "oneOf": [{ "$ref": "result.json" }, { "$ref": "duration.json" }] }
        }
      }
    }
  }
}
